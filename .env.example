# LORDGEN environment variables
# Copy to .env and fill in real values. Never commit .env.
# No values are set here — this file only documents what future phases will need.

# --- n8n MCP (Phase 6 — Starter Automation) ---
# Connected via the claude.ai n8n connector, which holds its own auth --
# so no URL or token is needed here, and no `claude mcp add` is required.
# Adding one would create a duplicate server pointing at the same instance.
# Manage the connection in claude.ai settings; confirm with `claude mcp list`.
# See docs/n8n-reference.md for what the connection makes available.
# The two vars below are unused by any code in this repo; kept only as a record
# of what a manual (non-connector) setup would need.
N8N_MCP_SERVER_URL=
N8N_MCP_TOKEN=

# Dispatcher/technician approval recipient for the estimate-summary workflow.
# Used to set the n8n "Request Dispatcher Approval" Gmail node's recipient.
DISPATCHER_EMAIL=

# --- ClickUp MCP (Phase 7 — Integrations / Handoff tasks) ---
# ClickUp Workspace/Team ID and target List ID for implementation tasks.
CLICKUP_TEAM_ID=
CLICKUP_LIST_ID=
# Note: ClickUp MCP auth in this environment is handled via the ClickUp
# connector's own OAuth flow, not a static API key here. These IDs are
# for targeting the correct workspace/list once connected.

# --- Competition live-demo trigger (P0) — website/api/trigger-demo.js ---
# Set as real values ONLY in the Vercel project's Environment Variables
# dashboard, never here and never committed. This file documents names only.
# Each n8n webhook's Header Auth credential must use the header name
# "X-LordGen-Demo-Token" with a value matching the corresponding *_TOKEN var
# below. See docs/architecture.md's "Pending: Competition Live-Demo Trigger
# (P0)" section for the full design and the two workflow URLs.
N8N_DIAGNOSTIC_WEBHOOK_URL=
N8N_DIAGNOSTIC_WEBHOOK_TOKEN=
N8N_APPROVE_WEBHOOK_URL=
N8N_APPROVE_WEBHOOK_TOKEN=
